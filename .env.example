# Copy to .env and fill in. Never commit .env.

# LTA DataMall AccountKey (free): https://datamall.lta.gov.sg/content/datamall/en/request-for-api.html
LTA_ACCOUNT_KEY=

# Optional: data.gov.sg API key, only if you hit rate limits
DATAGOV_API_KEY=

# Vision-language model for the triage step (any OpenAI-compatible endpoint)
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
